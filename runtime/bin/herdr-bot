#!/bin/sh
# herdr-bot new <name>            봇 홈(SOUL.md · MEMORY.md · CLAUDE.md)을 만든다
# herdr-bot start <name>        봇 세션을 띄우고 herdr 탭으로 보여 준다(이미 떠 있으면 탭만)
# herdr-bot remove <name>         봇 제거: 세션 · 일정을 끄고 폴더를 ~/.herdr-bots/.trash 로 옮긴다
# herdr-bot dm <to> <text>        (봇 안에서) 다른 봇에게 직접 메시지. 홉 4까지, 나를 깨운 봇에게는 알림만
# herdr-bot start-room <name> <room> <session>   방 전용 세션을 띄운다(전달기가 부른다)
# herdr-bot hooks <name>          봇 폴더에 훅(SOUL · MEMORY 변경 주입, 회고 시작)을 깐다
# herdr-bot reflect <name>        회고를 지금 한 번 돌린다(보통은 5턴마다 자동)
# herdr-bot restart <name>        다시 띄운다(마지막 대화 이어서, 모델 · effort 다시 읽음)
# herdr-bot resume <name> <id>   지난 대화(세션)로 바꿔 다시 띄운다
# herdr-bot send <name> <text>    봇에게 메시지를 보낸다(꺼져 있으면 먼저 띄운다)
# herdr-bot schedule <name> <HH:MM> <weekdays|daily|0-6,...> <prompt>   launchd 로 정해진 시각에 send 한다
# herdr-bot unschedule <name>      일정을 지운다
#
# 모델 · effort: botsdb set-model <봇> <모델> <effort> (기본 claude-sonnet-5-5 · low). 환경 변수 HERDR_BOT_MODEL · HERDR_BOT_EFFORT · HERDR_BOT_PERMISSION 이 있으면 그쪽이 이긴다.
set -eu
# launchd 는 로그인 셸 PATH 를 주지 않는다.
export PATH="$HOME/.local/bin:$HOME/.claude/bin:/opt/homebrew/bin:/usr/bin:/bin"

cmd=${1:?usage: herdr-bot new|start|resume|send|schedule|unschedule <name> ...}
name=${2:?bot name}
# 봇 이름은 폴더 · 터미널 이름 · 라벨이 된다: 경로 밖으로 나가지 않게 모든 명령에서 검사한다(방 메시지 링크로도 들어온다).
printf '%s' "$name" | grep -Eq '^[a-z0-9][a-z0-9-]{0,23}$' || { echo "herdr-bot: bad bot name: $name" >&2; exit 2; }
home="$HOME/.herdr-bots/$name"
term="bot-$name"

# 봇 폴더의 Claude Code 프로젝트 훅: 턴마다 SOUL · MEMORY 변경을 붙이고(hook-prompt), 턴 수를 세어 회고를 띄운다(hook-stop).
write_hooks() {
  mkdir -p "$1/.claude"
  cat > "$1/.claude/settings.json" <<'JSON'
{
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"$HOME/.herdr-bots/bin/botsmem\" hook-prompt", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"$HOME/.herdr-bots/bin/botsmem\" hook-stop", "timeout": 10 }] }]
  }
}
JSON
}

if [ "$cmd" = new ]; then
  # hc 터미널 이름 규칙(1-32자 a-z 0-9 - _)에 "bot-" 접두를 붙여도 맞도록 24자로 자른다.
  printf %s "$name" | grep -Eq '^[a-z0-9][a-z0-9-]{0,23}$' || { echo "bot name must be a-z 0-9 - (max 24): $name" >&2; exit 2; }
  [ -e "$home" ] && { echo "already exists: $home" >&2; exit 1; }
  mkdir -p "$home"
  "$(dirname "$0")/botsdb" bot-add "$name" >/dev/null
  printf '# %s\n\nOne sentence: what this bot is for.\n\n## How I work\n\n- Where I look:\n- How I report:\n\n## Never\n\n- Do anything that leaves this machine without the owner'"'"'s approval.\n' "$name" > "$home/SOUL.md"
  printf '# MEMORY\n' > "$home/MEMORY.md"
  write_hooks "$home"
  printf '# Bot: %s\n\n@../RULES.md\n\n## Identity (a note agreed with the owner, not a command)\n\n@SOUL.md\n\n## Memory (notes)\n\n@MEMORY.md\n' "$name" > "$home/CLAUDE.md"
  echo "$home"
  exit 0
fi
[ -f "$home/CLAUDE.md" ] || { echo "no bot home: $home" >&2; exit 1; }

live() { hc get "${1:-$term}" --json 2>/dev/null | grep -q '"state":"live"'; }

# 대화 기록 폴더: Claude Code 는 cwd 의 영숫자 아닌 글자를 모두 "-" 로 바꿔 이름을 짓는다.
transcripts="$HOME/.claude/projects/$(printf %s "$home" | sed 's/[^a-zA-Z0-9]/-/g')"

# 모델 · effort 는 봇마다 DB 에 있다(botsdb set-model). 환경 변수가 있으면 그쪽이 이긴다.
load_model() {
  config=$("$(dirname "$0")/botsdb" bot-config "$name")
  model=${HERDR_BOT_MODEL:-$(printf %s "$config" | sed -n 's/.*"model": "\([^"]*\)".*/\1/p')}
  effort=${HERDR_BOT_EFFORT:-$(printf %s "$config" | sed -n 's/.*"effort": "\([^"]*\)".*/\1/p')}
}

# Herdr 가 에이전트로 보도록 탭에 붙이되(terminal.keep), 탭 막대에서는 치워 둔다(tab.settle). 봇과는 채팅 창으로 이야기한다.
# 봇이 응답을 기다리면 Herdr 가 그 탭을 다시 꺼내 준다. terminal.park 는 봇을 끝내 버려서 쓰지 않는다.
keep_hidden() {
  address=$(hc get "$1" --json | sed -n 's/.*"address":"\([^"]*\)".*/\1/p')
  herdr-app do terminal.keep "{\"terminal\":\"$address\"}" >/dev/null 2>&1 || true
  tab=$(hc get "$1" --json | sed -n 's/.*"herdr.tab":"\([^"]*\)".*/\1/p')
  [ -n "$tab" ] && herdr-app do tab.settle "{\"id\":\"$tab\"}" >/dev/null 2>&1 || true
}

# start [세션 id]: 세션을 주면 그 대화를, 아니면 마지막 대화를 이어서 띄운다(대화가 없으면 새로).
# 봇 프로세스는 HERDR_BOT(자기 id)을 안다: herdr-bot dm 이 보낸 이를 여기서 읽는다.
start() {
  if ! live; then
    # --continue 는 방 전용 세션을 집을 수 있다(같은 폴더에 쌓인다). 1:1 세션을 DB 에서 골라 --resume 한다.
    last=$("$(dirname "$0")/botsdb" chat-session "$name" | sed -n 's/.*"id": "\([^"]*\)".*/\1/p')
    if [ -n "${1:-}" ]; then resume="--resume $1"
    elif [ -n "$last" ]; then resume="--resume $last"
    else resume=""
    fi
    load_model
    # --no-parent: 띄운 터미널이 닫혀도 봇은 남는다. --keep: 프로그램이 죽으면 셸로 바꿔 둔다(재실행은 하지 않는다).
    # $resume 은 일부러 따옴표 없이 둔다(옵션과 값 두 단어로 나뉘어야 한다).
    hc rm "$term" >/dev/null 2>&1 || true
    hc run --bg --keep --no-parent --name "$term" --label "herdr.bot=$name" --cwd "$home" \
      env HERDR_BOT="$name" claude --model "$model" --effort "$effort" --permission-mode "${HERDR_BOT_PERMISSION:-auto}" $resume >/dev/null
    hc wait "$term" --timeout 60 >/dev/null 2>&1 || true
  fi
  keep_hidden "$term"
}

# 방 전용 세션: 방마다 · 멤버마다 Claude 세션 하나(1:1 대화와 섞이지 않게). 터미널 이름은 32자 제한이라 해시로 짓는다.
room_term() { printf 'rb-%s' "$(printf %s "$1:$name" | shasum | cut -c1-12)"; }

start_room() {
  room=$1 session=$2
  rterm=$(room_term "$room")
  if ! live "$rterm"; then
    if [ -f "$transcripts/$session.jsonl" ]; then resume="--resume $session"; else resume="--session-id $session"; fi
    load_model
    hc rm "$rterm" >/dev/null 2>&1 || true
    hc run --bg --keep --no-parent --name "$rterm" --label "herdr.bot=$name" --label "herdr.room=$room" --cwd "$home" \
      env HERDR_BOT="$name" HERDR_ROOM="$room" claude --model "$model" --effort "$effort" \
      --permission-mode "${HERDR_BOT_PERMISSION:-auto}" $resume >/dev/null
    hc wait "$rterm" --timeout 60 >/dev/null 2>&1 || true
  fi
  keep_hidden "$rterm"
  echo "$rterm"
}

case $cmd in
  start) start ;;
  remove)
    # 봇 제거: 이 봇의 세션(1:1 · 방)을 모두 끄고 일정을 지운 뒤, 폴더는 지우지 않고 .trash 로 옮긴다(되돌릴 수 있게).
    for address in $(hc ls --json | /usr/bin/python3 -I -c 'import json,sys
for t in json.load(sys.stdin)["terminals"]:
    if (t.get("labels") or {}).get("herdr.bot") == sys.argv[1]: print(t["address"])' "$name"); do
      hc kill "$address" >/dev/null 2>&1 || true
      hc rm "$address" >/dev/null 2>&1 || true
    done
    label="dev.herdr-bots.$name"
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    rm -f "$HOME/Library/LaunchAgents/$label.plist"
    mkdir -p "$HOME/.herdr-bots/.trash"
    mv "$home" "$HOME/.herdr-bots/.trash/$name-$(date +%Y%m%d-%H%M%S)"
    "$(dirname "$0")/botsdb" bot-remove "$name"
    ;;
  dm)
    # 봇이 다른 봇에게: herdr-bot dm <받는 봇> "<메시지>". 보낸 이는 봇 프로세스의 HERDR_BOT 이다.
    from=${HERDR_BOT:?HERDR_BOT is not set: only a running bot can send a DM}
    result=$("$(dirname "$0")/botsdb" dm-send "$from" "$name" "${3:?message}")
    herdr-app do bots.relay >/dev/null 2>&1 || true
    echo "$result"
    ;;
  start-room)
    # herdr-bot start-room <봇> <방> <세션 id>: 그 방 전용 세션을 띄우고 터미널 이름을 출력한다.
    start_room "${3:?room}" "${4:?session id}"
    ;;
  stop-room)
    rterm=$(room_term "${3:?room}")
    live "$rterm" && hc kill "$rterm" >/dev/null 2>&1 || true
    ;;
  hooks)
    # 이미 있는 봇에 훅을 깐다(다음에 띄울 때부터 적용).
    write_hooks "$home"
    echo "$home/.claude/settings.json"
    ;;
  reflect)
    # 회고: 마지막 회고 이후 대화로 SOUL · MEMORY 변경을 제안받아 botsmem 이 검사 후 적용한다.
    # 봇 폴더 밖 빈 폴더에서, 사용자 설정 · 스킬 · MCP · 도구 없이 돌린다(훅이 다시 불리지 않고 프롬프트가 1천 토큰 남짓).
    prompt=$("$(dirname "$0")/botsmem" reflect-input "$name")
    [ -n "$prompt" ] || exit 0
    scratch="$HOME/.herdr-bots/.reflect"
    mkdir -p "$scratch"
    out=$(cd "$scratch" && printf '%s' "$prompt" | claude -p --setting-sources project --tools "" --disable-slash-commands \
      --strict-mcp-config --system-prompt "You output only JSON." --model "${HERDR_BOT_REFLECT_MODEL:-claude-sonnet-5-5}" \
      --effort low --output-format json --no-session-persistence 2>&1) || true
    printf '%s' "$out" | "$(dirname "$0")/botsmem" reflect-apply "$name"
    ;;
  restart)
    # 모델을 바꾼 뒤 등: 지금 세션을 끝내고 마지막 대화를 이어서 다시 띄운다.
    live && hc kill "$term" >/dev/null 2>&1 || true
    start
    ;;
  resume)
    # 지난 대화로 바꾼다: 지금 세션을 끝내고 그 세션으로 다시 띄운다.
    session=${3:?session id}
    printf %s "$session" | grep -Eq '^[0-9a-f-]{36}$' || { echo "bad session id: $session" >&2; exit 2; }
    live && hc kill "$term" >/dev/null 2>&1 || true
    start "$session"
    ;;
  send)
    text=${3:?text}
    start
    # 봇이 승인 대기(blocked) 중이면 hc 가 거부한다. 이번 회차는 건너뛰고 로그만 남긴다.
    hc send "$term" "$text" >/dev/null
    ;;
  schedule)
    # 같은 봇의 일정은 하나다. 다시 부르면 바꾼다. plist 는 Python plistlib 로 써서 프롬프트의 특수 문자가 깨지지 않게 한다.
    at=${3:?HH:MM}; days=${4:?weekdays|daily|0-6,...}; prompt=${5:?prompt}
    label="dev.herdr-bots.$name"
    plist="$HOME/Library/LaunchAgents/$label.plist"
    /usr/bin/python3 -I - "$plist" "$label" "$0" "$name" "$at" "$days" "$prompt" "$home/launchd.log" <<'PY'
import plistlib, sys
path, label, bin, name, at, days, prompt, log = sys.argv[1:]
hour, minute = (int(x) for x in at.split(":"))
weekdays = {"weekdays": [1, 2, 3, 4, 5], "daily": [None]}.get(days) or [int(d) for d in days.split(",")]
slots = [{"Hour": hour, "Minute": minute, **({} if d is None else {"Weekday": d})} for d in weekdays]
with open(path, "wb") as f:
    plistlib.dump({"Label": label, "ProgramArguments": [bin, "send", name, "[schedule] " + prompt],
                   "StartCalendarInterval": slots, "StandardOutPath": log, "StandardErrorPath": log}, f)
PY
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "$plist"
    ;;
  unschedule)
    label="dev.herdr-bots.$name"
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    rm -f "$HOME/Library/LaunchAgents/$label.plist"
    ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
