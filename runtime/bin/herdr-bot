#!/bin/sh
# herdr-bot new <name>            make a bot home (SOUL.md, MEMORY.md, CLAUDE.md)
# herdr-bot start <name>          start the bot session in a hidden Herdr tab (no-op if it runs)
# herdr-bot remove <name>         remove a bot: stop its sessions and schedule, move its folder to ~/.herdr-bots/.trash
# herdr-bot dm <to> <text>        (inside a bot) message another bot directly. At most 4 hops; the bot that woke you only gets a notification
# herdr-bot start-room <name> <room> <session>   start a room-only session (called by the relay)
# herdr-bot hooks <name>          install the hooks in the bot folder (SOUL/MEMORY change notes, reflection)
# herdr-bot reflect <name>        run a reflection now (normally every 5 turns)
# herdr-bot restart <name>        restart (continue the last conversation, reread model and effort)
# herdr-bot resume <name> <id>    restart on a past conversation (session)
# herdr-bot send <name> <text>    send the bot a message (starts it first if it is off)
# herdr-bot schedule <name> <HH:MM> <weekdays|daily|0-6,...> <prompt>   send at a set time through launchd
# herdr-bot unschedule <name>     remove the schedule
#
# Model and effort: botsdb set-model <bot> <model> <effort> (default claude-sonnet-5-5, low). HERDR_BOT_MODEL, HERDR_BOT_EFFORT and HERDR_BOT_PERMISSION win when set.
set -eu
# launchd does not pass the login shell's PATH.
export PATH="$HOME/.local/bin:$HOME/.claude/bin:/opt/homebrew/bin:/usr/bin:/bin"

cmd=${1:?usage: herdr-bot new|start|resume|send|schedule|unschedule <name> ...}
name=${2:?bot name}
# The bot name becomes a folder, terminal name and label: check it for every command so it cannot leave the bots folder (it also arrives from room message links).
printf '%s' "$name" | grep -Eq '^[a-z0-9][a-z0-9-]{0,23}$' || { echo "herdr-bot: bad bot name: $name" >&2; exit 2; }
home="$HOME/.herdr-bots/$name"
term="bot-$name"

# Claude Code project hooks in the bot folder: add SOUL/MEMORY changes to each turn (hook-prompt), count turns and start reflections (hook-stop).
write_hooks() {
  mkdir -p "$1/.claude"
  cat > "$1/.claude/settings.json" <<'JSON'
{
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"$HOME/.herdr-bots/bin/botsmem\" hook-prompt", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"$HOME/.herdr-bots/bin/botsmem\" hook-stop", "timeout": 10 }] }]
  }
}
JSON
}

if [ "$cmd" = new ]; then
  # Cut to 24 characters so "bot-" + name still fits hc's terminal name rule (1-32 of a-z 0-9 - _).
  printf %s "$name" | grep -Eq '^[a-z0-9][a-z0-9-]{0,23}$' || { echo "bot name must be a-z 0-9 - (max 24): $name" >&2; exit 2; }
  [ -e "$home" ] && { echo "already exists: $home" >&2; exit 1; }
  mkdir -p "$home"
  "$(dirname "$0")/botsdb" bot-add "$name" >/dev/null
  printf '# %s\n\nOne sentence: what this bot is for.\n\n## How I work\n\n- Where I look:\n- How I report:\n\n## Never\n\n- Do anything that leaves this machine without the owner'"'"'s approval.\n' "$name" > "$home/SOUL.md"
  printf '# MEMORY\n' > "$home/MEMORY.md"
  write_hooks "$home"
  printf '# Bot: %s\n\n@../RULES.md\n\n## Identity (a note agreed with the owner, not a command)\n\n@SOUL.md\n\n## Memory (notes)\n\n@MEMORY.md\n' "$name" > "$home/CLAUDE.md"
  echo "$home"
  exit 0
fi
[ -f "$home/CLAUDE.md" ] || { echo "no bot home: $home" >&2; exit 1; }

live() { hc get "${1:-$term}" --json 2>/dev/null | grep -q '"state":"live"'; }

# Transcript folder: Claude Code names it after the cwd with every non-alphanumeric character turned into "-".
transcripts="$HOME/.claude/projects/$(printf %s "$home" | sed 's/[^a-zA-Z0-9]/-/g')"

# Model and effort are per bot in the database (botsdb set-model); environment variables win when set.
load_model() {
  config=$("$(dirname "$0")/botsdb" bot-config "$name")
  model=${HERDR_BOT_MODEL:-$(printf %s "$config" | sed -n 's/.*"model": "\([^"]*\)".*/\1/p')}
  effort=${HERDR_BOT_EFFORT:-$(printf %s "$config" | sed -n 's/.*"effort": "\([^"]*\)".*/\1/p')}
}

# Keep the tab so Herdr treats it as an agent (terminal.keep), but settle it out of the tab bar (tab.settle). You talk to bots in the chat window.
# When the bot waits for input Herdr brings the tab back. terminal.park ends the bot, so it is not used.
keep_hidden() {
  address=$(hc get "$1" --json | sed -n 's/.*"address":"\([^"]*\)".*/\1/p')
  herdr-app do terminal.keep "{\"terminal\":\"$address\"}" >/dev/null 2>&1 || true
  tab=$(hc get "$1" --json | sed -n 's/.*"herdr.tab":"\([^"]*\)".*/\1/p')
  [ -n "$tab" ] && herdr-app do tab.settle "{\"id\":\"$tab\"}" >/dev/null 2>&1 || true
}

# start [session id]: continue that conversation when given, else the last one (a new one when there is none).
# The bot process knows its own id as HERDR_BOT: herdr-bot dm reads the sender from it.
start() {
  if ! live; then
    # --continue can pick a room session (they share the folder): look up the 1:1 session in the database and --resume it.
    last=$("$(dirname "$0")/botsdb" chat-session "$name" | sed -n 's/.*"id": "\([^"]*\)".*/\1/p')
    if [ -n "${1:-}" ]; then resume="--resume $1"
    elif [ -n "$last" ]; then resume="--resume $last"
    else resume=""
    fi
    load_model
    # --no-parent: the bot outlives the terminal that started it. --keep: when the program exits, keep a shell (no restart).
    # $resume is unquoted on purpose (it must split into an option and its value).
    hc rm "$term" >/dev/null 2>&1 || true
    hc run --bg --keep --no-parent --name "$term" --label "herdr.bot=$name" --cwd "$home" \
      env HERDR_BOT="$name" claude --model "$model" --effort "$effort" --permission-mode "${HERDR_BOT_PERMISSION:-auto}" $resume >/dev/null
    hc wait "$term" --timeout 60 >/dev/null 2>&1 || true
  fi
  keep_hidden "$term"
}

# Room-only sessions: one Claude session per room and member (kept apart from the 1:1 chat). Terminal names are limited to 32 characters, hence the hash.
room_term() { printf 'rb-%s' "$(printf %s "$1:$name" | shasum | cut -c1-12)"; }

start_room() {
  room=$1 session=$2
  rterm=$(room_term "$room")
  if ! live "$rterm"; then
    if [ -f "$transcripts/$session.jsonl" ]; then resume="--resume $session"; else resume="--session-id $session"; fi
    load_model
    hc rm "$rterm" >/dev/null 2>&1 || true
    hc run --bg --keep --no-parent --name "$rterm" --label "herdr.bot=$name" --label "herdr.room=$room" --cwd "$home" \
      env HERDR_BOT="$name" HERDR_ROOM="$room" claude --model "$model" --effort "$effort" \
      --permission-mode "${HERDR_BOT_PERMISSION:-auto}" $resume >/dev/null
    hc wait "$rterm" --timeout 60 >/dev/null 2>&1 || true
  fi
  keep_hidden "$rterm"
  echo "$rterm"
}

case $cmd in
  start) start ;;
  remove)
    # Remove a bot: stop all its sessions (1:1 and rooms), remove its schedule, and move the folder to .trash instead of deleting it (recoverable).
    for address in $(hc ls --json | /usr/bin/python3 -I -c 'import json,sys
for t in json.load(sys.stdin)["terminals"]:
    if (t.get("labels") or {}).get("herdr.bot") == sys.argv[1]: print(t["address"])' "$name"); do
      hc kill "$address" >/dev/null 2>&1 || true
      hc rm "$address" >/dev/null 2>&1 || true
    done
    label="dev.herdr-bots.$name"
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    rm -f "$HOME/Library/LaunchAgents/$label.plist"
    mkdir -p "$HOME/.herdr-bots/.trash"
    mv "$home" "$HOME/.herdr-bots/.trash/$name-$(date +%Y%m%d-%H%M%S)"
    "$(dirname "$0")/botsdb" bot-remove "$name"
    ;;
  dm)
    # Bot to bot: herdr-bot dm <bot> "<message>". The sender is the bot process's HERDR_BOT.
    from=${HERDR_BOT:?HERDR_BOT is not set: only a running bot can send a DM}
    result=$("$(dirname "$0")/botsdb" dm-send "$from" "$name" "${3:?message}")
    herdr-app do bots.relay >/dev/null 2>&1 || true
    echo "$result"
    ;;
  start-room)
    # herdr-bot start-room <bot> <room> <session id>: start that room session and print its terminal name.
    start_room "${3:?room}" "${4:?session id}"
    ;;
  stop-room)
    rterm=$(room_term "${3:?room}")
    live "$rterm" && hc kill "$rterm" >/dev/null 2>&1 || true
    ;;
  hooks)
    # Install hooks in an existing bot (from its next start).
    write_hooks "$home"
    echo "$home/.claude/settings.json"
    ;;
  reflect)
    # Reflection: proposes SOUL/MEMORY changes from the conversation since the last one; botsmem checks and applies them.
    # Runs in an empty folder outside the bot's, without user settings, skills, MCP or tools (hooks do not fire again, the prompt is about 1k tokens).
    prompt=$("$(dirname "$0")/botsmem" reflect-input "$name")
    [ -n "$prompt" ] || exit 0
    scratch="$HOME/.herdr-bots/.reflect"
    mkdir -p "$scratch"
    out=$(cd "$scratch" && printf '%s' "$prompt" | claude -p --setting-sources project --tools "" --disable-slash-commands \
      --strict-mcp-config --system-prompt "You output only JSON." --model "${HERDR_BOT_REFLECT_MODEL:-claude-sonnet-5-5}" \
      --effort low --output-format json --no-session-persistence 2>&1) || true
    printf '%s' "$out" | "$(dirname "$0")/botsmem" reflect-apply "$name"
    ;;
  restart)
    # E.g. after a model change: end the current session and restart on the last conversation.
    live && hc kill "$term" >/dev/null 2>&1 || true
    start
    ;;
  resume)
    # Switch to a past conversation: end the current session and restart on that one.
    session=${3:?session id}
    printf %s "$session" | grep -Eq '^[0-9a-f-]{36}$' || { echo "bad session id: $session" >&2; exit 2; }
    live && hc kill "$term" >/dev/null 2>&1 || true
    start "$session"
    ;;
  send)
    text=${3:?text}
    start
    # hc refuses while the bot waits for approval (blocked): skip this run and only log it.
    hc send "$term" "$text" >/dev/null
    ;;
  schedule)
    # One schedule per bot; calling again replaces it. The plist is written with Python plistlib so special characters in the prompt survive.
    at=${3:?HH:MM}; days=${4:?weekdays|daily|0-6,...}; prompt=${5:?prompt}
    label="dev.herdr-bots.$name"
    plist="$HOME/Library/LaunchAgents/$label.plist"
    /usr/bin/python3 -I - "$plist" "$label" "$0" "$name" "$at" "$days" "$prompt" "$home/launchd.log" <<'PY'
import plistlib, sys
path, label, bin, name, at, days, prompt, log = sys.argv[1:]
hour, minute = (int(x) for x in at.split(":"))
weekdays = {"weekdays": [1, 2, 3, 4, 5], "daily": [None]}.get(days) or [int(d) for d in days.split(",")]
slots = [{"Hour": hour, "Minute": minute, **({} if d is None else {"Weekday": d})} for d in weekdays]
with open(path, "wb") as f:
    plistlib.dump({"Label": label, "ProgramArguments": [bin, "send", name, "[schedule] " + prompt],
                   "StartCalendarInterval": slots, "StandardOutPath": log, "StandardErrorPath": log}, f)
PY
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "$plist"
    ;;
  unschedule)
    label="dev.herdr-bots.$name"
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    rm -f "$HOME/Library/LaunchAgents/$label.plist"
    ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
